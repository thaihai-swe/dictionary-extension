  "en": [
    {
      "partOfSpeech": "Noun",
      "language": "English",
      "definitions": [
        {
          "definition": "A <a rel=\"mw:WikiLink\" href=\"/wiki/disembodied\" title=\"disembodied\">disembodied</a> <a rel=\"mw:WikiLink\" href=\"/wiki/soul\" title=\"soul\">soul</a>; a soul or <a rel=\"mw:WikiLink\" href=\"/wiki/spirit\" title=\"spirit\">spirit</a> of a <a rel=\"mw:WikiLink\" href=\"/wiki/deceased\" title=\"deceased\">deceased</a> <a rel=\"mw:WikiLink\" href=\"/wiki/person\" title=\"person\">person</a>; a spirit <a rel=\"mw:WikiLink\" href=\"/wiki/appear\" title=\"appear\">appearing</a> <a rel=\"mw:WikiLink\" href=\"/wiki/after\" title=\"after\">after</a> <a rel=\"mw:WikiLink\" href=\"/wiki/death\" title=\"death\">death</a>.",
          "parsedExamples": [
            {
              "example": "Everyone believed that the <b>ghost</b> of an old lady haunted the crypt."
            },
            {
              "example": "He believes in <b>ghosts</b>."
            }
          ],
          "examples": [
            "Everyone believed that the <b>ghost</b> of an old lady haunted the crypt.",
            "He believes in <b>ghosts</b>."
          ]
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt68\" typeof=\"mw:Transclusion\"></span> A <a rel=\"mw:WikiLink\" href=\"/wiki/spirit\" title=\"spirit\">spirit</a>; a human <a rel=\"mw:WikiLink\" href=\"/wiki/soul\" title=\"soul\">soul</a>."
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt74\" typeof=\"mw:Transclusion\"></span> Any faint shadowy semblance; an unsubstantial image.",
          "parsedExamples": [
            {
              "example": "not a <b>ghost</b> of a chance"
            },
            {
              "example": "the <b>ghost</b> of an idea"
            }
          ],
          "examples": [
            "not a <b>ghost</b> of a chance",
            "the <b>ghost</b> of an idea"
          ]
        },
        {
          "definition": "A false image, such as in a photographic print or negative, on a television screen, radar display, or telescope, caused by poor or double reception or reflection (from a lens or screen)<!--, or a defect in the receiver?-->."
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt84\" typeof=\"mw:Transclusion\"></span> A faint image that remains after an attempt to remove <a rel=\"mw:WikiLink\" href=\"/wiki/graffiti\" title=\"graffiti\">graffiti</a>."
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt87\" typeof=\"mw:Transclusion\"></span> <span class=\"form-of-definition use-with-mention\" about=\"#mwt88\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#ellipsis\" title=\"Appendix:Glossary\">Ellipsis</a> of <span class=\"form-of-definition-link\"><i class=\"Latn mention\" lang=\"en\"><a rel=\"mw:WikiLink\" href=\"/wiki/ghostwriter#English\" title=\"ghostwriter\">ghostwriter</a></i></span></span><link rel=\"mw:PageProp/Category\" href=\"./Category:English_ellipses#GHOST\" about=\"#mwt88\">.",
          "parsedExamples": [
            {
              "example": "I’ve written both as a <b>ghost</b> for experts and under my name."
            }
          ],
          "examples": [
            "I’ve written both as a <b>ghost</b> for experts and under my name."
          ]
        },
        {
          "definition": "A <a rel=\"mw:WikiLink\" href=\"/wiki/nonexistent\" title=\"nonexistent\">nonexistent</a> person invented to obtain some (typically <a rel=\"mw:WikiLink\" href=\"/wiki/fraudulent\" title=\"fraudulent\">fraudulent</a>) <a rel=\"mw:WikiLink\" href=\"/wiki/benefit\" title=\"benefit\">benefit</a>."
        },
        {
          "definition": "A <a rel=\"mw:WikiLink\" href=\"/wiki/dead\" title=\"dead\">dead</a> person whose <a rel=\"mw:WikiLink\" href=\"/wiki/identity\" title=\"identity\">identity</a> is stolen by another <span class=\"mention-gloss-paren\" about=\"#mwt96\" typeof=\"mw:Transclusion\">(</span><span class=\"mention-gloss\" about=\"#mwt96\">see <i class=\"Latn mention\" lang=\"en\"><a rel=\"mw:WikiLink\" href=\"/wiki/ghosting#English\" title=\"ghosting\">ghosting</a></i></span><span class=\"mention-gloss-paren\" about=\"#mwt96\">)</span>. <span class=\"maintenance-line\" about=\"#mwt97\" typeof=\"mw:Transclusion\">(<span id=\"rfv-sense-notice-en-\"></span>Can we <a rel=\"mw:WikiLink\" href=\"/wiki/Wiktionary:Requests_for_verification/English#ghost\" title=\"Wiktionary:Requests for verification/English\">verify</a> this sense?)</span><link rel=\"mw:PageProp/Category\" href=\"./Category:Requests_for_verification_in_English_entries#GHOST\" about=\"#mwt97\">"
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt98\" typeof=\"mw:Transclusion\"></span> An unresponsive user on <a rel=\"mw:WikiLink\" href=\"/wiki/IRC\" title=\"IRC\">IRC</a>, resulting from the user's <a rel=\"mw:WikiLink\" href=\"/wiki/client\" title=\"client\">client</a> disconnecting without notifying the <a rel=\"mw:WikiLink\" href=\"/wiki/server\" title=\"server\">server</a>."
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt100\" typeof=\"mw:Transclusion\"></span> A <a rel=\"mw:WikiLink\" href=\"/wiki/copy\" title=\"copy\">copy</a> of a <a rel=\"mw:WikiLink\" href=\"/wiki/file\" title=\"file\">file</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/record\" title=\"record\">record</a>."
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt102\" typeof=\"mw:Transclusion\"></span> An <a rel=\"mw:WikiLink\" href=\"/wiki/understudy\" title=\"understudy\">understudy</a>. <span class=\"maintenance-line\" about=\"#mwt103\" typeof=\"mw:Transclusion\">(<span id=\"rfv-sense-notice-en-\"></span>Can we <a rel=\"mw:WikiLink\" href=\"/wiki/Wiktionary:Requests_for_verification/English#ghost\" title=\"Wiktionary:Requests for verification/English\">verify</a> this sense?)</span><link rel=\"mw:PageProp/Category\" href=\"./Category:Requests_for_verification_in_English_entries#GHOST\" about=\"#mwt103\">"
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt104\" typeof=\"mw:Transclusion\"></span> A <a rel=\"mw:WikiLink\" href=\"/wiki/covert\" title=\"covert\">covert</a> (and <a rel=\"mw:WikiLink\" href=\"/wiki/deniable\" title=\"deniable\">deniable</a>) agent."
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt106\" typeof=\"mw:Transclusion\"></span> An <a rel=\"mw:WikiLink\" href=\"/wiki/opponent\" title=\"opponent\">opponent</a> in a <a rel=\"mw:WikiLink\" href=\"/wiki/race\" title=\"race\">racing</a> <a rel=\"mw:WikiLink\" href=\"/wiki/game\" title=\"game\">game</a> that follows a previously <a rel=\"mw:WikiLink\" href=\"/wiki/record\" title=\"record\">recorded</a> <a rel=\"mw:WikiLink\" href=\"/wiki/route\" title=\"route\">route</a>, allowing players to compete against previous best times."
        },
        {
          "definition": "Someone whose <a rel=\"mw:WikiLink\" href=\"/wiki/identity\" title=\"identity\">identity</a> cannot be established because there are no records of such a  person."
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt110\" typeof=\"mw:Transclusion\"></span> An <a rel=\"mw:WikiLink\" href=\"/wiki/unphysical\" title=\"unphysical\">unphysical</a> <a rel=\"mw:WikiLink\" href=\"/wiki/state\" title=\"state\">state</a> in a <a rel=\"mw:WikiLink\" href=\"/wiki/gauge_theory\" title=\"gauge theory\">gauge theory</a>."
        },
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt113\" typeof=\"mw:Transclusion\"></span> A formerly <a rel=\"mw:WikiLink\" href=\"/wiki/nonexistent\" title=\"nonexistent\">nonexistent</a> <a rel=\"mw:WikiLink\" href=\"/wiki/character\" title=\"character\">character</a> that was at some point <a rel=\"mw:WikiLink\" href=\"/wiki/mistaken\" title=\"mistaken\">mistakenly</a> <a rel=\"mw:WikiLink\" href=\"/wiki/encoded\" title=\"encoded\">encoded</a> into a <a rel=\"mw:WikiLink\" href=\"/wiki/character_set\" title=\"character set\">character set</a> <a rel=\"mw:WikiLink\" href=\"/wiki/standard\" title=\"standard\">standard</a>, which might have since become used <a rel=\"mw:WikiLink\" href=\"/wiki/opportunistic\" title=\"opportunistic\">opportunistically</a> for some <a rel=\"mw:WikiLink\" href=\"/wiki/genuine\" title=\"genuine\">genuine</a> purpose.",
          "parsedExamples": [
            {
              "example": "<i class=\"Jpan mention\" lang=\"ja\"><a rel=\"mw:WikiLink\" href=\"/wiki/彁#Japanese\" title=\"彁\">彁</a></i> is a <b>ghost</b> character from the Japanese JIS X 0208 character set."
